{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "netops/inventory.schema.json",
  "title": "NetOps Inventory (network/hosts.yaml)",
  "description": "Valida a estrutura do inventario de hosts. Campos herdaveis (vendor, role, access, credential) podem vir do host OU do seu grupo; por isso sao opcionais aqui e a checagem de presenca apos a heranca e feita em scripts/lib/inventory.py.",
  "type": "object",
  "required": ["version", "hosts"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "enum": [1, 2] },
    "next_host_id": { "$ref": "#/$defs/hostId" },
    "legacy_aliases": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["alias", "host_id"],
        "properties": {
          "alias": { "type": "string", "minLength": 1 },
          "host_id": { "$ref": "#/$defs/hostId" }
        }
      }
    },
    "groups": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/nodeFields" }
    },
    "hosts": {}
  },
  "allOf": [{
    "if": {"properties": {"version": {"const": 2}}, "required": ["version"]},
    "then": {
      "required": ["next_host_id", "groups", "legacy_aliases"],
      "properties": {"hosts": {"type": "array", "items": {
        "allOf": [{"$ref": "#/$defs/hostFields"}, {
          "required": ["id"], "properties": {"id": {"$ref": "#/$defs/hostId"}}
        }]
      }}}
    },
    "else": {
      "properties": {"hosts": {"type": "object", "additionalProperties": {"$ref": "#/$defs/hostFields"}}},
      "not": {"anyOf": [{"required": ["next_host_id"]}, {"required": ["legacy_aliases"]}]}
    }
  }],
  "$defs": {
    "hostId": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "hostFields": {
      "allOf": [{"$ref": "#/$defs/nodeFields"}, {
        "type": "object", "required": ["hostname", "mgmt_ip"],
        "properties": {
          "hostname": {"type": "string", "minLength": 1},
          "mgmt_ip": {"type": "string", "minLength": 1},
          "extra_ips": {
            "type": "array", "maxItems": 20,
            "description": "IPs adicionais do host (publico, interno, VIP...). Apenas informativo: scripts conectam pelo mgmt_ip.",
            "items": {
              "type": "object", "additionalProperties": false, "required": ["ip"],
              "properties": {
                "ip": {"type": "string", "minLength": 1, "maxLength": 64},
                "role": {"type": "string", "maxLength": 40},
                "description": {"type": "string", "maxLength": 200}
              }
            }
          },
          "group": {"type": "string"}
        }
      }]
    },
    "nodeFields": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "vendor": {
          "type": "string",
          "enum": ["mikrotik", "unifi", "ubiquiti", "cisco", "huawei", "proxmox", "vmware", "datacom", "linux", "fiberhome", "intelbras", "other"]
        },
        "role": {
          "type": "string",
          "enum": ["core", "distribution", "access", "firewall", "wireless", "server", "other"]
        },
        "icon": { "type": "string", "maxLength": 64, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "description": "ID do ícone local de rede (ex.: router, switch)." },
        "model": { "type": "string" },
        "version": { "type": "string", "maxLength": 80, "description": "Versão do SO/firmware OU da aplicação principal do host (ex.: RouterOS 7.16.2, Debian 12, Zabbix 7.0.32, EVE-NG 6.2.0-4, PVE 8.4.21)." },
        "site": { "type": "string" },
        "notes": { "type": "string" },
        "credential": { "type": "string" },
        "backup_before_change": { "type": "boolean", "description": "Backup automático antes/depois de mudanças (scripts/tools/backup/change.py)." },
        "access": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "method": { "type": "string", "enum": ["ssh", "telnet", "api", "winbox"] },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        }
      }
    }
  }
}
