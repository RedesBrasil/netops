# NetOps — arquivos que NUNCA devem ser versionados.

# >>> SEGREDOS — credenciais (cofre 'enc.v1:' ou texto puro). NUNCA commitar. <<<
# (atenção: o .gitignore NÃO aceita comentário na mesma linha do padrão — sempre em linha própria)
network/credentials.yaml
# temporário de escrita atômica do cofre (scripts/vault/cli.py + scripts/ui)
network/*.tmp
# backups da UI (credentials.yaml.bak.* pode conter segredos) — nunca commitar
network/*.bak.*

# >>> INVENTÁRIO REAL DE PRODUÇÃO — fica só nesta máquina. <<<
# Versionamos apenas os modelos *.example.yaml; o inventário real nunca vai ao repositório.
network/hosts.yaml
network/topology.yaml
# topology.md é GERADO por scripts/docs/topology_render.py a partir do inventário real
network/topology.md

# Scripts de análise específicos de produção (DADOS DO CLIENTE) — manter local.
# Pasta INTEIRA ignorada (evita que novos one-offs escapem, como acontecia na lista
# arquivo-a-arquivo antiga). Os genéricos do framework vivem em scripts/tools/analysis/
# (security_assessment.py, checks.yaml) e continuam versionados.
scripts/analysis/

# Relatórios gerados a partir do inventário/execução real (DADOS DO CLIENTE) — manter
# local. Ignora tudo em reports/, exceto o README (documentação do diretório).
reports/*
!reports/README.md

# Saídas brutas de execução (podem conter dados sensíveis dos dispositivos)
runs/

# Estado, snapshots privados e ambientes do atualizador. Nunca publicar.
/.netops-update/
/.netops-venvs/

# Ambiente Python
.venv/
__pycache__/
*.pyc
*.pyo

# Sessões/artefatos locais
*.session
*.log
# token de sessão antigo do console web (removido; mantido no ignore p/ instalações legadas)
scripts/ui/.ui-token
scripts/engine/ui/.ui-token

# Config local da IDE de IA (específico da máquina, não compartilhar)
.claude/settings.local.json
# Skills injetadas pelo ambiente local da IDE (links para caminhos pessoais).
/.codex/

# Cache de testes
.pytest_cache/

# Backups de trabalho (edições assistidas / segurança) — nunca versionar.
# Cobre *.bak-sec, *.bak-l1, *.bak-l1fix, etc., além de *.orig e *.bak simples.
*.orig
*.bak
*.bak-*
# backups da UI ao editar o AGENTS.md pelo menu Memória
/AGENTS.md.bak.*

# Sistema operacional / editor
.DS_Store
Thumbs.db
*.swp

# >>> Artefatos de HOME/IDE — o home do usuário `netops` É a raiz do repo. <<<
# Credenciais do Claude, transcrições, histórico de shell, cache: NUNCA versionar.
# Mantém .claude/commands/ (slash commands compartilhados); ignora o resto do .claude/.
/.claude.json
/.bash_history
/.cache/
/.claude/*
!/.claude/commands/
!/.claude/settings.json
!/.claude/hooks/

# Backups coletados de equipamentos reais (config real de device) — nunca versionar.
# Exceção: backups/exemplo/ (placeholder sem segredo, para demonstrar a feature).
backups/*
!backups/exemplo/
# Config de serviços de backup (referencia hosts reais) — runtime, como hosts.yaml.
network/backups.yaml
# tarefas agendadas (comandos/prompts locais) — ver scripts/engine/scheduler/SKILL.md
network/schedules.yaml
network/.inventory.lock
network/.host-id-migration.json

# Mapas reais e ferramentas de build (assets finais são versionados).
network/maps.yaml
scripts/engine/ui/maps/node_modules/
scripts/engine/ui/maps/build-meta.json
/core/config/*.bak.*

# backups de edição da memória e segredos soltos
memory/*.bak.*
.env
.env.*
*.pem
*.key
*.pfx
*.p12
id_rsa*
id_ed25519*
/.claude/.credentials.json

# Cópias de segurança avulsas (*.bak.<data>) nunca sobem
*.bak.*
