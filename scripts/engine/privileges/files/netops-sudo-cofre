#!/usr/bin/python3 -I
"""NetOps — `sudo` da conta operacional SÓ com o cofre destrancado (chamado pelo PAM, como root).

Instalado em /usr/local/sbin/netops-sudo-cofre por scripts/engine/privileges/provision.py.
/etc/pam.d/sudo: `auth [success=done default=ignore] pam_exec.so quiet /usr/local/sbin/netops-sudo-cofre`
Sai 0 (libera sem senha) apenas se PAM_USER = conta operacional e a sessão do cofre dela for válida:
  - /run/user/<uid>/netops/session.key: dono = a conta, 0600 (pasta 0700), sem symlink;
  - mesmo boot (boot_id) e não expirada (TTL do cofre);
  - a chave confere com um verificador FIXADO pelo root em /etc/netops/vault-verifier.d/<slug>.pin
    (HMAC-SHA256 do token Fernet; a conta operacional não consegue trocar o pin).
Qualquer outra coisa: sai 1 e o PAM segue o fluxo normal (a conta não tem senha => sudo negado).
Só stdlib e arquivos root-owned (nada da árvore da instalação roda como root aqui).

Uso manual (root):  netops-sudo-cofre --check              estado, sem segredos
                    netops-sudo-cofre --pin /opt/netops    refixa o verificador da instalação (cofre destrancado)
"""
import base64, glob, hashlib, hmac, os, pwd, re, stat, struct, sys, syslog, time

CONF = "/etc/netops/privileges.conf"
PIN_DIR = "/etc/netops/vault-verifier.d"
HEADER = ">8sBQQIH"
MAGIC = b"NETOPSK1"
ENC_PREFIX = "enc.v1:"


def log(msg):
    syslog.openlog("netops-sudo-cofre", 0, syslog.LOG_AUTHPRIV)
    syslog.syslog(syslog.LOG_NOTICE, msg)


def root_owned(path, mode_mask=0o022):
    st = os.stat(path)
    if st.st_uid != 0 or stat.S_IMODE(st.st_mode) & mode_mask:
        raise ValueError(f"{path} inseguro (precisa ser do root, sem escrita de grupo/outros)")


def op_user():
    root_owned(CONF)
    for line in open(CONF):
        m = re.match(r"^\s*NETOPS_RUNTIME_USER=([a-z_][a-z0-9_-]{0,31})\s*$", line)
        if m and m.group(1) != "root":
            return m.group(1)
    raise ValueError("conta operacional ausente em " + CONF)


def session_key(uid):
    d = f"/run/user/{uid}/netops"
    st = os.lstat(d)
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != uid or stat.S_IMODE(st.st_mode) != 0o700:
        raise ValueError("pasta da sessão insegura")
    fd = os.open(d + "/session.key", os.O_RDONLY | os.O_NOFOLLOW)
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_uid != uid or stat.S_IMODE(st.st_mode) != 0o600:
            raise ValueError("arquivo da sessão inseguro")
        data = os.read(fd, 65536)
    finally:
        os.close(fd)
    hs = struct.calcsize(HEADER)
    magic, ver, _created, expires, _ttl, blen = struct.unpack(HEADER, data[:hs])
    if magic != MAGIC or ver != 1:
        raise ValueError("formato desconhecido")
    boot = data[hs:hs + blen]
    with open("/proc/sys/kernel/random/boot_id") as f:
        if boot != f.read().strip().encode():
            raise ValueError("sessão de outro boot")
    if expires <= int(time.time()):
        raise ValueError("sessão expirada")
    (klen,) = struct.unpack(">H", data[hs + blen:hs + blen + 2])
    key = data[hs + blen + 2:hs + blen + 2 + klen]
    if len(key) != 32:
        raise ValueError("chave inválida")
    return key, expires


def fernet_ok(key, value):
    if not value.startswith(ENC_PREFIX):
        return False
    token = value[len(ENC_PREFIX):]
    raw = base64.urlsafe_b64decode(token + "=" * (-len(token) % 4))
    if len(raw) < 1 + 8 + 16 + 32 or raw[0] != 0x80:
        return False
    mac = hmac.new(key[:16], raw[:-32], hashlib.sha256).digest()
    return hmac.compare_digest(mac, raw[-32:])


def pins():
    out = []
    for p in sorted(glob.glob(PIN_DIR + "/*.pin")):
        try:
            root_owned(p, 0o077)
            out.append(open(p).read().strip())
        except (OSError, ValueError):
            continue
    if not out:
        raise ValueError("nenhum verificador fixado em " + PIN_DIR)
    return out


def verifier_from_creds(root):
    txt = open(os.path.join(root, "network", "credentials.yaml"), encoding="utf-8").read()
    m = re.search(r"^vault:\s*\n((?:[ \t]+.*\n?)+)", txt, re.M)
    v = m and re.search(r"^[ \t]+verifier:\s*['\"]?(enc\.v1:[A-Za-z0-9_=-]+)", m.group(1), re.M)
    if not v:
        raise SystemExit("ERRO: verificador do cofre não encontrado em " + root + "/network/credentials.yaml")
    return v.group(1)


def check():
    user = op_user()
    uid = pwd.getpwnam(user).pw_uid
    key, expires = session_key(uid)
    if not any(fernet_ok(key, p) for p in pins()):
        raise ValueError("chave não confere com o verificador fixado")
    return user, expires


def main():
    if len(sys.argv) >= 2 and sys.argv[1] == "--pin":
        if os.geteuid() != 0 or len(sys.argv) != 3:
            raise SystemExit("uso (root): netops-sudo-cofre --pin <pasta-da-instalação>")
        root = os.path.realpath(sys.argv[2])
        value = verifier_from_creds(root)
        key, _ = session_key(pwd.getpwnam(op_user()).pw_uid)  # só fixa o que a chave destrancada abre
        if not fernet_ok(key, value):
            raise SystemExit("ERRO: o verificador de credentials.yaml não confere com o cofre destrancado")
        slug = re.sub(r"[^A-Za-z0-9]+", "-", root.strip("/")).strip("-") or "root"   # = runtime_identity.slug
        os.makedirs(PIN_DIR, mode=0o700, exist_ok=True)
        dst = os.path.join(PIN_DIR, slug + ".pin")
        with open(dst + ".tmp", "w") as f:
            f.write(value + "\n")
        os.chmod(dst + ".tmp", 0o600)
        os.replace(dst + ".tmp", dst)
        print("verificador fixado em", dst)
        return 0
    if "--check" in sys.argv:
        try:
            user, exp = check()
            print(f"liberado: cofre de {user} destrancado (expira em {exp - int(time.time())} s sem uso)")
            return 0
        except Exception as e:
            print(f"negado: {e}")
            return 1
    # modo PAM
    try:
        user = op_user()
    except Exception:
        return 1
    if os.environ.get("PAM_USER") != user or os.environ.get("PAM_SERVICE") != "sudo":
        return 1
    try:
        check()
    except Exception as e:
        log(f"sudo de {user} NEGADO (cofre trancado/inválido: {e})")
        return 1
    log(f"sudo de {user} liberado (cofre destrancado)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
