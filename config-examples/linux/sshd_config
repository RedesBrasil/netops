# ============================================================
# Exemplo: sshd_config endurecido — Linux (Ubuntu/Debian)
# Testado em: OpenSSH 9.x
# Ajuste antes de aplicar: a porta, o grupo permitido (AllowGroups) e o caminho do banner.
# Boa prática relacionada: best-practices/general/ssh-hardening.md
# Aplicar: copiar para /etc/ssh/sshd_config.d/99-netops.conf e 'systemctl reload ssh'.
# ATENÇÃO: garanta que sua chave pública já está instalada ANTES de desligar a senha.
# ============================================================

Port 22

# --- Autenticação: chave sim, senha não, root sem senha ---
PubkeyAuthentication yes
PasswordAuthentication no
PermitRootLogin prohibit-password
PermitEmptyPasswords no

# --- Limites contra brute force ---
MaxAuthTries 3
LoginGraceTime 30
MaxSessions 4

# --- Sessão ociosa: derruba após ~10 min ---
ClientAliveInterval 300
ClientAliveCountMax 2

# --- Reduzir superfície ---
X11Forwarding no
AllowTcpForwarding no
AllowAgentForwarding no

# --- Restringir quem pode logar (crie o grupo: groupadd ssh-users) ---
AllowGroups ssh-users

# --- Criptografia moderna ---
KexAlgorithms curve25519-sha256,curve25519-sha256@libssh.org
Ciphers chacha20-poly1305@openssh.com,aes256-gcm@openssh.com
MACs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com

# --- Aviso legal ---
Banner /etc/issue.net
